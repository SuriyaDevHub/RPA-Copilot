# Copy to .env for local DEV. Never commit real values. See docs/SPEC.md §1.
GC_ENV=dev
GC_DATABASE_URL=sqlite:///./data/copilot.db
# Production: mssql+pyodbc://@<host>/<db>?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes
GC_DATA_DIR=./data

# GenAI gateway (OPEN_QUESTIONS #1-#4)
GC_TOKEN_URL=https://CHANGE-ME/token
GC_TOKEN_CLIENT_ID=
GC_TOKEN_CLIENT_SECRET=
GC_TOKEN_HEADER=Authorization
GC_TOKEN_SCHEME=Bearer
GC_LLM_BASE_URL=https://CHANGE-ME/v1
GC_LLM_PRIMARY_MODEL=CHANGE-ME
GC_LLM_FALLBACK_MODEL=
GC_EMBED_MODEL=text-embedding-small
GC_LLM_TIMEOUT_S=30
GC_EMBED_TIMEOUT_S=10
GC_LLM_MAX_INPUT_TOKENS=6000
GC_LLM_MAX_OUTPUT_TOKENS=1000

# S3 (OPEN_QUESTIONS #5)
GC_S3_BUCKET=
GC_S3_LOG_PREFIX=
GC_S3_EVIDENCE_PREFIX=
GC_WATCHER_INTERVAL_S=90
GC_WATCHER_BOTS=bot-a,bot-b

# Jira (OPEN_QUESTIONS #10)
GC_JIRA_BASE_URL=
GC_JIRA_TOKEN=
GC_JIRA_PROJECT=
GC_JIRA_ISSUE_TYPE=
GC_JIRA_FIELD_MAP={}

# Mail (OPEN_QUESTIONS #12)
GC_SMTP_HOST=
GC_SMTP_PORT=25
GC_MAIL_FROM=
GC_SUPPORT_MAILBOX=

GC_UI_BASE_URL=http://localhost:8000
GC_AUTH_MODE=dev
GC_CONFIDENCE_THRESHOLD=0.8
GC_FEATURE_SELF_HEAL=false
GC_WORKER_CONCURRENCY=1
